# Multicard payment gateway (copy to .env, which is gitignored; or put the same
# keys into the systemd EnvironmentFile on servers). Only MULTICARD_* keys are
# read from .env, and real environment variables always win.
MULTICARD_ENABLED=1
# Sandbox. Production (only after Multicard approves the test integration): https://mesh.multicard.uz
MULTICARD_BASE_URL=https://dev-mesh.multicard.uz
MULTICARD_APPLICATION_ID=
MULTICARD_SECRET=
MULTICARD_STORE_ID=
# Public HTTPS URL Multicard calls after a successful payment:
#   https://<public-api-host>/api/v1/payments/multicard/callback/
MULTICARD_CALLBACK_URL=
# Shopper return pages (a signed status token is appended as the last path segment).
MULTICARD_WEB_RETURN_URL=https://bodysteel.uz/payment/multicard
MULTICARD_APP_RETURN_URL=https://bodysteel.uz/app/payment
# Fiscal receipt codes from tasnif.soliq.uz. Product.ikpu_code/package_code win.
MULTICARD_DEFAULT_IKPU=
MULTICARD_DEFAULT_PACKAGE_CODE=
MULTICARD_DELIVERY_IKPU=
MULTICARD_DELIVERY_PACKAGE_CODE=
MULTICARD_VAT_PERCENT=
MULTICARD_TIN=
MULTICARD_INVOICE_TTL_SECONDS=1800
MULTICARD_TIMEOUT_SECONDS=10
# Optional: only accept callbacks from these client IPs (Multicard: 195.158.26.90).
MULTICARD_CALLBACK_ALLOWED_IPS=

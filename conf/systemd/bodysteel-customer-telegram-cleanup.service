[Unit]
Description=Clean old BodySteel customer Telegram technical records

[Service]
Type=oneshot
User=root
Group=www-data
WorkingDirectory=/home/body/current
EnvironmentFile=/etc/bodysteel/gunicorn-release.env
ExecStart=/home/body/current/venv/bin/python manage.py purge_customer_telegram_records
NoNewPrivileges=true
PrivateTmp=true

[Unit]
Description=BodySteel native push delivery worker
After=network-online.target

[Service]
Type=oneshot
User=root
Group=www-data
WorkingDirectory=/home/body/current
EnvironmentFile=/etc/bodysteel/gunicorn-release.env
ExecStart=/home/body/current/venv/bin/python manage.py deliver_push_notifications --limit 100
NoNewPrivileges=true
PrivateTmp=true

import os

from django.core.exceptions import ImproperlyConfigured


DEBUG = False
SECRET_KEY = os.getenv('SECRET_KEY', '')
ALLOWED_HOSTS = [
    host.strip()
    for host in os.getenv('ALLOWED_HOSTS', '').split(',')
    if host.strip()
]
DATABASE_PASSWORD = os.getenv('DATABASE_PASSWORD', '')
BODYSTEEL_STOREFRONT_PROXY_TOKEN = os.getenv('BODYSTEEL_STOREFRONT_PROXY_TOKEN', '')
PHONE_VERIFICATION_HASH_KEY = os.getenv('PHONE_VERIFICATION_HASH_KEY', '')
AUTH_RATE_LIMIT_HASH_KEY = os.getenv('AUTH_RATE_LIMIT_HASH_KEY', '')
SMS_BACKEND = os.getenv('SMS_BACKEND', '')

AUTH_SECRETS = (
    BODYSTEEL_STOREFRONT_PROXY_TOKEN,
    PHONE_VERIFICATION_HASH_KEY,
    AUTH_RATE_LIMIT_HASH_KEY,
)

if (
    not SECRET_KEY
    or not ALLOWED_HOSTS
    or not DATABASE_PASSWORD
    or any(len(value.encode('utf-8')) < 32 for value in AUTH_SECRETS)
    or len(set(AUTH_SECRETS)) != len(AUTH_SECRETS)
    or SMS_BACKEND != 'eskiz'
):
    raise ImproperlyConfigured(
        'Database, independent auth secrets and SMS_BACKEND=eskiz are required in production'
    )

DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.postgresql',
        'NAME': os.getenv('DATABASE_NAME', 'bodysteel'),
        'USER': os.getenv('DATABASE_USER', 'bodysteel'),
        'PASSWORD': DATABASE_PASSWORD,
        'HOST': os.getenv('DATABASE_HOST', 'localhost'),
        'PORT': os.getenv('DATABASE_PORT', '5432'),
        'CONN_MAX_AGE': 60,
    }
}
